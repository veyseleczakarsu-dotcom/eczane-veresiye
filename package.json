{
  "name": "eczane-veresiye-masaustu",
  "version": "1.0.17",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.eczane.veresiye",
    "productName": "Eczane Veresiye",
    "files": [
      "index.html",
      "main.js",
      "package.json",
      "README.txt"
    ],
    "win": {
      "target": "nsis",
      "artifactName": "Eczane-Veresiye-Kurulum.exe"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false
    },
    "publish": {
      "provider": "github",
      "owner": "veyseleczakarsu-dotcom",
      "repo": "eczane-veresiye",
      "releaseType": "release"
    }
  },
  "allowScripts": {
    "electron@45.5.0": true
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  }
}
